---
config:
  class:
    hideEmptyMembersBox: true
---
classDiagram
    direction LR
    class User {
        email
        student_number
    }
    class ProgramMembership {
        role
        cohort_year
    }
    class Program {
        code
        name
        attainment_threshold
    }
    class ProgramOutcomeSet {
        label
        effective_from_year
        is_active
    }
    class ProgramOutcome {
        number
        short_name
    }
    class Course {
        code
        title
        credits
    }
    class Term {
        code
        starts_on
        status
    }
    class CourseOffering {
        section
        syllabus
    }
    class Enrollment {
        status
    }
    class LearningOutcome {
        number
        description
    }
    class Assessment {
        name
        kind
        max_score
        published_at
    }
    class AssessmentLOWeight {
        weight : 1-100 %
    }
    class LOPOWeight {
        weight : 1-5
        source
    }
    class Grade {
        score
        published_score
        is_excused
    }
    class AuditEvent {
        action
        before
        after
    }
    User "1" -- "*" ProgramMembership
    Program "1" -- "*" ProgramMembership
    Program "1" *-- "*" ProgramOutcomeSet
    ProgramOutcomeSet "1" *-- "11" ProgramOutcome
    Program "1" *-- "*" Course
    Course "1" -- "*" CourseOffering
    Term "1" -- "*" CourseOffering
    CourseOffering "*" -- "*" User : instructors
    CourseOffering "1" *-- "*" Enrollment
    User "1" -- "*" Enrollment : student
    CourseOffering "1" *-- "*" LearningOutcome
    CourseOffering "1" *-- "*" Assessment
    Assessment "1" -- "*" AssessmentLOWeight
    LearningOutcome "1" -- "*" AssessmentLOWeight
    LearningOutcome "1" -- "*" LOPOWeight
    ProgramOutcome "1" -- "*" LOPOWeight
    Assessment "1" -- "*" Grade
    Enrollment "1" -- "*" Grade
    User "1" -- "*" AuditEvent : actor
